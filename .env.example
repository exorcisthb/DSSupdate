# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO_OWNER=exorcisthb
GITHUB_REPO_NAME=DSSupdate
GITHUB_BRANCH=main
GITHUB_DATA_PATH=

# Database Configuration (choose one)
DATABASE_URL=sqlite:///./dss_data.db
